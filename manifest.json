{
  "manifest_version": 3,
  "name": "Link Shield - Malicious URL Detector",
  "short_name": "Link Shield",
  "version": "1.0.0",
  "description": "Advanced real-time malicious URL detector, anti-phishing scanner, and threat intelligence shield with live toolbar status badge.",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Link Shield — Malicious URL Detector",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["detector.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/*.png",
        "assets/ui/*.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
